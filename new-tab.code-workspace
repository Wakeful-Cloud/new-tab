{
  "extensions": {
    "recommendations": [
      "EditorConfig.EditorConfig",
      "Vue.volar",
      "bierner.github-markdown-preview",
      "oxc.oxc-vscode",
      "seatonjiang.gitmoji-vscode"
    ]
  },
  "folders": [
    {
      "path": ".",
      "name": "root"
    }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Build",
        "request": "launch",
        "runtimeArgs": [
          "run-script",
          "build"
        ],
        "runtimeExecutable": "npm",
        "skipFiles": [
          "<node_internals>/**"
        ],
        "type": "node"
      },
      {
        "name": "Dev",
        "request": "launch",
        "runtimeArgs": [
          "run-script",
          "dev"
        ],
        "runtimeExecutable": "npm",
        "skipFiles": [
          "<node_internals>/**"
        ],
        "type": "node"
      }
    ],
    "compounds": []
  },
  "settings": {
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "always"
    },
    "editor.rulers": [
      100
    ],
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "[markdown]": {
      "editor.wordWrap": "wordWrapColumn",
      "editor.wordWrapColumn": 100
    },
    "[html]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[css]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[vue]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    }
  }
}